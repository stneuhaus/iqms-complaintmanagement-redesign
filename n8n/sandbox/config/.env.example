# OCR+Transform workflow — environment settings
#
# Copy to .env and fill in. Never commit the filled-in file.
# Secrets (client secret, API tokens) do NOT belong here — they go into the
# n8n credential store. This file holds identifiers and switches only.

# --- n8n runtime -------------------------------------------------------------
# Required: without this every $env lookup returns empty and the first Graph
# call fails with a confusing 404.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Required by the 'Collect output files' node, which base64-encodes the
# reconstructed Markdown. Without it: "Cannot find module 'buffer'".
NODE_FUNCTION_ALLOW_BUILTIN=buffer

# --- SharePoint --------------------------------------------------------------
# The full comma-joined site id, e.g. contoso.sharepoint.com,8f1e...,3b2d...
# GET https://graph.microsoft.com/v1.0/sites/{hostname}:/sites/{site-path}
SP_SITE_ID=

# GET https://graph.microsoft.com/v1.0/sites/{SP_SITE_ID}/lists?$filter=displayName eq 'Your List'
SP_LIST_ID=

# --- Prompt file -------------------------------------------------------------
# Path INSIDE the n8n container. Mount the repo docs folder read-only.
# Pin the version — a released prompt file is immutable so a result stays
# traceable to what produced it.
PROMPT_FILE_PATH=/data/prompts/05-design-spec/promtpts for text recogniztion/prompt.ocr+transform.0.9.md

# --- myGenAssist -------------------------------------------------------------
MYGENASSIST_BASE_URL=
MYGENASSIST_MODEL_ID=

# Exit condition: five stages plus reserve.
MAX_CALLS_PER_DOCUMENT=8

# --- Budget measurement (optional) -------------------------------------------
# Leave false until the endpoint's behaviour is confirmed. With false, the
# quality report states 'not available', which is the prompt's normal case.
BUDGET_ENABLED=false
BUDGET_ENDPOINT_URL=
BUDGET_UNIT=EUR

# remaining  = endpoint reports credit left   -> consumed = baseline - current
# cumulative = endpoint reports spend to date -> consumed = current - baseline
# Wrong value puts a NEGATIVE number in the quality report.
BUDGET_MODE=remaining
