# Secrets and local config
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# MCP — .mcp.json is committed and holds no secret (token comes from $N8N_MCP_TOKEN).
# A local override would hold the token verbatim, so it never gets committed.
.mcp.local.json

# n8n
.n8n/
n8n-*.json.bak
**/credentials/

# instruct-ai local state
.instruct-ai/

# Python
.venv/
venv/
__pycache__/
*.pyc

# OS and editors
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/

# Misc
*.log
tmp/
temp/
.temp/*
